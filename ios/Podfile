platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Fix "Multiple commands produce libsuper_native_extensions.a".
  #
  # The cargokit Rust build-phase and the pod's native static-library
  # target both write to ${BUILT_PRODUCTS_DIR}/libsuper_native_extensions.a.
  # Furthermore libtool (Create Static Library) overwrites the Rust .a with
  # an ObjC-only archive, losing Rust symbols.  To solve both problems we:
  #
  #   1. After the Rust build, move the Rust .a to a dedicated sibling
  #      directory (super_native_extensions_rust/) so it survives libtool.
  #   2. Rewrite the script phase's output_paths to the new location so
  #      Xcode no longer sees two commands producing the same file.
  #   3. Rewrite -force_load in every generated xcconfig that references the
  #      old path, using ${PODS_CONFIGURATION_BUILD_DIR} which resolves
  #      identically in both pod-target and Runner contexts.
  rust_dest_var = '${PODS_CONFIGURATION_BUILD_DIR}/super_native_extensions_rust'
  rust_lib_var  = "#{rust_dest_var}/libsuper_native_extensions.a"

  installer.pods_project.targets.each do |target|
    # ── Step 1+2: redirect the Rust build phase ──
    target.build_phases.each do |phase|
      next unless phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
      next unless phase.name&.include?('Build SuperNativeExtensions')

      phase.output_paths = [rust_lib_var]

      unless phase.shell_script.to_s.include?('super_native_extensions_rust')
        phase.shell_script = phase.shell_script.to_s.rstrip + "\n" + <<~'RELOC'
          # ── relocate Rust lib to avoid duplicate-product conflict ──
          _sne_rust_dest="${PODS_CONFIGURATION_BUILD_DIR}/super_native_extensions_rust"
          mkdir -p "$_sne_rust_dest"
          if [ -f "${BUILT_PRODUCTS_DIR}/libsuper_native_extensions.a" ]; then
            mv "${BUILT_PRODUCTS_DIR}/libsuper_native_extensions.a" \
               "$_sne_rust_dest/libsuper_native_extensions.a"
          fi
        RELOC
      end
    end

    # ── Step 3: rewrite -force_load in generated xcconfigs ──
    target.build_configurations.each do |config|
      xcconfig_ref = config.base_configuration_reference
      next unless xcconfig_ref
      xcconfig_path = xcconfig_ref.real_path.to_s
      next unless File.exist?(xcconfig_path)
      content = File.read(xcconfig_path)
      old_flag = '-force_load ${BUILT_PRODUCTS_DIR}/libsuper_native_extensions.a'
      new_flag = "-force_load #{rust_lib_var}"
      if content.include?(old_flag)
        File.write(xcconfig_path, content.gsub(old_flag, new_flag))
      end
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if deployment_target.nil? || deployment_target.to_f < 13.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      end

      # Pod targets must never require provisioning profiles in CI archives.
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
      config.build_settings['PROVISIONING_PROFILE'] = ''
      config.build_settings['DEVELOPMENT_TEAM'] = ''
      config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'

      if target.name == 'SQLCipher'
        # SQLCipher sqlite3.c can trigger this on Apple clang; keep scope narrow to this pod.
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        warning_cflags = config.build_settings['WARNING_CFLAGS'] || ['$(inherited)']
        warning_cflags = [warning_cflags] unless warning_cflags.is_a?(Array)
        warning_cflags << '-Wno-shorten-64-to-32' unless warning_cflags.include?('-Wno-shorten-64-to-32')
        config.build_settings['WARNING_CFLAGS'] = warning_cflags
      end
    end
  end
end
