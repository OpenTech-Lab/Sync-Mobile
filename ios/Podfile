platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Fix "Multiple commands produce libsuper_native_extensions.a".
  #
  # The Rust build-phase (cargokit / super_native_extensions) declares
  # libsuper_native_extensions.a in its output_paths.  CocoaPods' native
  # static-library target for the same pod ALSO produces a .a with the
  # identical name.  Xcode's new build system rejects two commands that
  # claim the same product.
  #
  # We strip the conflicting .a entry from the script's output_paths and
  # replace it with a sentinel stamp file that the script touches at the
  # end.  This keeps Xcode's dependency graph intact (the script still has
  # a declared output so it runs in deterministic order) without a
  # duplicate-product conflict.
  installer.pods_project.targets.each do |target|
    target.build_phases.each do |phase|
      next unless phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
      next unless phase.name&.include?('Build SuperNativeExtensions') ||
                  (phase.output_paths || []).any? { |p| p.include?('libsuper_native_extensions') }

      original = phase.output_paths || []
      cleaned  = original.reject { |p| p.include?('libsuper_native_extensions') }
      next if cleaned.length == original.length          # nothing conflicting

      stamp = '$(DERIVED_FILE_DIR)/super_native_extensions_build.stamp'
      cleaned << stamp unless cleaned.include?(stamp)
      phase.output_paths = cleaned

      unless phase.shell_script.to_s.include?('super_native_extensions_build.stamp')
        phase.shell_script = phase.shell_script.to_s.rstrip +
          "\ntouch \"${DERIVED_FILE_DIR}/super_native_extensions_build.stamp\"\n"
      end
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if deployment_target.nil? || deployment_target.to_f < 13.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      end

      # Pod targets must never require provisioning profiles in CI archives.
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
      config.build_settings['PROVISIONING_PROFILE'] = ''
      config.build_settings['DEVELOPMENT_TEAM'] = ''
      config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'

      if target.name == 'SQLCipher'
        # SQLCipher sqlite3.c can trigger this on Apple clang; keep scope narrow to this pod.
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        warning_cflags = config.build_settings['WARNING_CFLAGS'] || ['$(inherited)']
        warning_cflags = [warning_cflags] unless warning_cflags.is_a?(Array)
        warning_cflags << '-Wno-shorten-64-to-32' unless warning_cflags.include?('-Wno-shorten-64-to-32')
        config.build_settings['WARNING_CFLAGS'] = warning_cflags
      end
    end
  end
end
